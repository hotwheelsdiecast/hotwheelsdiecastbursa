<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>WhatsApp Form Gönderme</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f4f4f4;
      padding: 20px;
    }
    .container {
      max-width: 400px;
      margin: auto;
      background: #fff;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }
    input, textarea, button {
      width: 100%;
      padding: 10px;
      margin-top: 10px;
      border-radius: 5px;
      border: 1px solid #bbb;
      font-size: 16px;
    }
    button {
      background: #25d366;
      color: white;
      border: none;
      cursor: pointer;
      font-weight: bold;
    }
    button:hover {
      background: #20b85a;
    }
  </style>
</head>
<body>
  <div class="container">
    <h2>Bilgi Gönder</h2>

    <label>Fotoğraf Yükle:</label>
    <input type="file" id="photo" accept="image/*" />

    <label>Yazı:</label>
    <textarea id="text" rows="4" placeholder="Bir şeyler yaz..."></textarea>

    <label>İsim Soyisim:</label>
    <input type="text" id="fullname" placeholder="İsim Soyisim" />

    <button onclick="sendWhatsApp()">Gönder</button>
  </div>

  <script>
    function sendWhatsApp() {
      const number = "5528859313";
      const text = document.getElementById("text").value;
      const fullname = document.getElementById("fullname").value;

      if (!text || !fullname) {
        alert("Lütfen tüm bilgileri doldurun!");
        return;
      }

      const message = `Yeni Gönderi:%0A%0Aİsim Soyisim: ${fullname}%0AMesaj: ${text}%0A%0AFotoğraf: Fotoğraf yüklendi (dosya gönderme kullanıcı tarafından yapılmalıdır)`;

      const url = `https://wa.me/${number}?text=${message}`;

            const body = `Yeni Gönderi:%0A%0Aİsim Soyisim: ${fullname}%0AMesaj: ${text}%0A%0AFotoğraf: Fotoğraf yüklendi (dosya ekleme kullanıcı tarafından yapılmalıdır)`;

      const mail = `mailto:emiraliter13@gmail.com?subject=Yeni%20Form%20Gönderisi&body=${body}`;

      window.location.href = mail; // Mail uygulamasını açar
    }
  </script>
</body>
</html>
